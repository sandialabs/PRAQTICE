# this script generates LoQS and DEM data for random CPTP error models, Steane code SE

import os
os.environ['OPENBLAS_NUM_THREADS'] = '1' 
os.environ['GOTO_NUM_THREADS'] = '1' 
os.environ['OMP_NUM_THREADS'] = '1' 
os.environ['NUMEXPR_NUM_THREADS'] = '1' 
os.environ['VECLIB_MAXIMUM_THREADS'] = '1' 
os.environ['MKL_NUM_THREADS'] = '1' 

from mpi4py import MPI 
comm = MPI.COMM_WORLD
rank = comm.Get_rank()
size = comm.Get_size()

from collections import Counter
import numpy as np
import pygsti
from pygsti.extras.dem_construction import pygsti_object_builders as obj
import stim
from pygsti.extras.dem_construction import dem_tools as dems
import scipy as sp
import pygsti.tools.errgenproptools as eprop
from pygsti.errorgenpropagation.errorpropagator import ErrorGeneratorPropagator
import pickle

from loqs.backends.circuit import PyGSTiPhysicalCircuit
from loqs.backends.state import QSimQuantumState
from loqs.codepacks import codepack_7_1_3_quantinuum2021 as codepack
from loqs.tools import pygstitools as pt
from loqs.backends.circuit import PyGSTiPhysicalCircuit
from loqs.backends.model import PyGSTiNoiseModel
from loqs.backends.state import QSimQuantumState
from loqs.core import QuantumProgram, History
from loqs.core.recordables import PatchDict

from pygsti.baseobjs.statespace import QubitSpace as _QubitSpace
import pygsti.baseobjs as _bo
from pygsti.baseobjs.errorgenlabel import GlobalElementaryErrorgenLabel as _GlobalElementaryErrorgenLabel, \
                                          LocalElementaryErrorgenLabel as _LocalElementaryErrorgenLabel
import pygsti.tools.lindbladtools as lbd

from loqs_dems_helpers import * 

###parameters to tune###
rounds = 2
num_shca_terms = [10,0,0,0]#[5,5,5,5]#number of terms in the sparse models for 2Q gates
s_params=np.array([0.001/15, 0.0002/15])#parameters for sampling 2Q gate errors
h_params=np.array([0,np.sqrt(0.001)/5])
n_shots_loqs = 5000
num_models = 2

cnot_unitary = pygsti.tools.internalgates.standard_gatename_unitaries()['Gcnot']

for nm in range(num_models):
    ###construct pspec and model###
    qubits = [f'Q{i}' for i in range(10)]#["A0", "A1", "A2"] + [f"D{i+2}" for i in range(7)]
    
    ideal_model = codepack.create_ideal_model(qubits) # 7 physical qubit model for simulating 1 logical qubit
    code = codepack.create_qec_code(circuit_backend=PyGSTiPhysicalCircuit)
    
    availability={'Gcnot':[(a,b) for a in qubits for b in qubits if a != b]}
    pspec = pygsti.processors.QubitProcessorSpec(len(qubits), ['Gh', 'Gcnot','Gi'], qubit_labels=qubits, availability=availability)
    
    error_rates_dict = {'Gcnot': generate_random_sparse_shca_error_model(2, num_shca_terms, s_params, h_params, seed=1), 
                       'Gh': generate_random_sparse_shca_error_model(1, [3,0,0,0], s_params*0.1, h_params*np.sqrt(0.1), seed=1), #[3,3,2,2]
                       'Gi':generate_random_sparse_shca_error_model(1, [3,0,0,0], s_params*0.1, h_params*np.sqrt(0.1), seed=1)}
    
    twoq_gates = ['Gcnot']
    oneq_gates = [g for g in pspec.gate_names if g != 'Gcnot']
    
    model = obj.build_model(error_rates_dict, pspec, oneq_gates, twoq_gates)
    loqs_model = PyGSTiNoiseModel(model)
    
    program_kwargs = {
        "default_noise_model": ideal_model,
        "state_type": QSimQuantumState,
        "patch_types":  {"7Q": code}}
    
    initial_history_td1 = History(
        {
            "state": QSimQuantumState(len(qubits), qubit_labels=qubits),
            "patches": PatchDict({"L0": code.create_patch(qubits)}),
            "model": loqs_model # Note that we are putting our new model in!
        },
        expiring_keys=["state", "model"],
        propagating_keys=["state", "patches", "model"]
        )
    
    td_test_stack = [
        ("I", "L0"),
        ('Unflagged Parallel S1-S2-S3 Check', "L0"),
        ('Unflagged Parallel S4-S5-S6 Check', "L0"),
    ]*rounds+[('FT Logical Z Measure', "L0")]
    td_test_stack.insert(0,("Non-FT Zero Prep", "L0"))
    
    program_td1 = QuantumProgram(
        instruction_stack=td_test_stack,
        initial_history=initial_history_td1,
        name="test program"
    )
    
    program_td1.run(num_shots=n_shots_loqs, max_frame_limit=100000000)
    Counter(program_td1.collect_shot_data("logical_measurement", -1))
    
    outcomes_td1 = [
        [m[0] for mo in shot_mos[:-1] for m in mo.values()]+[compute_logical_outcome(shot_mos[-1])]
        for shot_mos in program_td1.collect_shot_data("measurement_outcomes", "all", strip_none_entries=True)
    ] #only want to compute logical for the logical measurement
    
    n_syndromes = 6
    n_data = 7
    
    count_dict = process_se_data_loqs(outcomes_td1, rounds, n_syndromes)
    
    ###DEM###
    hist = program_td1.collect_shot_data("logical_measurement", -1)
    h = program_td1.shot_histories[1]
    c = pygsti.circuits.circuit.Circuit(line_labels=qubits, editable=True)
    for j, i in enumerate(h.__dict__['_history']):
        if 'instruction' in i.keys():
            try:
                c.append_circuit_inplace(i['instruction'].data['circuit'].circuit)
            except:
                print(j, i['instruction'].data)
    
    expanded_c, measurements, qubit_mapping = expand_circuit(c)
    
    #constructing the detectors 
    n_qubits = len(expanded_c.line_labels)
    meas_as_int = [('Z',[int(m[1:])]) for m in measurements[:-1*n_data]]+[('Z'*n_data, [int(m[1:]) for m in measurements[-1*n_data:]])]
    detectors = []
    for k in range(n_syndromes):
        detectors.append(dems.get_detector_as_parity([k], meas_as_int, n_qubits))
    for i in range(1,rounds):
        for k in range(n_syndromes):
            #2-body Z stimpaulis
            detectors.append(dems.get_detector_as_parity([6*(i-1)+k, 6*i+k], meas_as_int, n_qubits)) #for d in detectors
    detectors.append(dems.get_detector_as_parity( [6*rounds], meas_as_int, n_qubits)) #logical observable
    
    exp_qubits = list(range(n_qubits))#["A0", "A1"] + [f"D{i+2}" for i in range(5)]
    
    exp_availability={'Gcphase':[(a,b) for a in exp_qubits for b in exp_qubits if a != b], 'Gcnot':[(a,b) for a in exp_qubits for b in exp_qubits if a != b], 'Gcnotp':[(a,b) for a in exp_qubits for b in exp_qubits if a != b]}
    exp_pspec = pygsti.processors.QubitProcessorSpec(len(exp_qubits), ['Gcphase' ,'Gh', 'Gypi','Gypi2', 'Gympi2', 'Gxpi2', 'Gxpi', 'Gxmpi2', 'Gi', 'Gc0', 'Gcnot', 'Gzpi2', 'Gzpi', 'Gcnotp'],
                                             availability=exp_availability, qubit_labels=exp_qubits, nonstd_gate_unitaries={'Gcnotp':cnot_unitary})
    
    exp_model = obj.build_model(error_rates_dict, exp_pspec, oneq_gates, twoq_gates)
    
    expanded_c = expanded_c.reorder_lines([f'Q{i}' for i in range(n_qubits)])
    expanded_c_int_labels = expanded_c.map_state_space_labels({f'Q{i}':i for i in range(n_qubits)})
    expanded_c_int_labels = expanded_c_int_labels.map_state_space_labels({i:i for i in range(n_qubits)})
    
    stim_c_no_extras = obj.pygsti_c_to_stim(expanded_c_int_labels)
    tableau = stim.Tableau.from_circuit(stim_c_no_extras, ignore_measurement=True) 
    inverse_tableau = tableau.inverse()

    stim_conversions = pygsti.tools.internalgates.standard_gatenames_stim_conversions()
    stim_conversions['Gcnotp'] = stim_conversions['Gcnot']
    
    egp = ErrorGeneratorPropagator(exp_model)
    
    eoc_eeg = egp.propagate_errorgens_bch(expanded_c_int_labels, bch_order=1, include_spam=False, circuit_conversion_kwargs={'gate_name_conversions':stim_conversions})

    
    sim = stim.TableauSimulator()
    sim.set_inverse_tableau(inverse_tableau)
    
    dem = dems.generate_dem_higher_order(detectors, eoc_eeg, sim,  zassenhaus_order=1, add_type='add')
    stim_dem_str = dems.format_dem_stim(dem, n_logical=0)
    stim_dem = stim.DetectorErrorModel(stim_dem_str)

    if rounds<3:
        outcome_distribution = compute_outcome_distribution_from_dem(stim_dem)

    else:
        outcome_distribution = stim_dem
    
    results_dict = {'dem_outcome_dist':outcome_distribution, 'dem':dem, 'loqs_samples': count_dict, 'edict':error_rates_dict}
    
    with open(f'loqs_data/loqs_dems_s_{rounds}_{rank}_{nm}_test_seeded.pkl', 'wb+') as f:
        pickle.dump(results_dict, f)

    print(f'saved results for model {nm}')
