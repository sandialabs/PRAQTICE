    "def build_error_dict(depol_rate, h_rates, damping_rate, idle_z_rate):\n",
    "    oneQ_depol_rate = 0.1*depol_rate\n",
    "    error_rates_dict = {}\n",
    "    error_rates_dict['Gi'] = {('S','X'):oneQ_depol_rate+damping_rate,('S','Y'):oneQ_depol_rate+damping_rate,('S','Z'):oneQ_depol_rate,('A','X','Y'):damping_rate,('H','Z'):idle_z_rate}\n",
    "    return error_rates_dict"
   ]
