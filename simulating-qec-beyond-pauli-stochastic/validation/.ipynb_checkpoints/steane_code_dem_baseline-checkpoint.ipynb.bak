   "execution_count": null,
   "id": "46a2f8df-8395-4ed7-8ff1-a372f08cb90d",
   "metadata": {},
   "outputs": [],
   "source": [
    "#get the pygsti circuit and define its detectors, which are just parities of adjacent SE rounds and the logical measurement (Z on all data Qs)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6f404714-634c-4b4d-8900-364562669acd",
   "metadata": {},
   "outputs": [],
   "source": [
    "hist = program_td1.collect_shot_data(\"logical_measurement\", -1)\n",
    "h = program_td1.shot_histories[1]\n",
    "c = pygsti.circuits.circuit.Circuit(line_labels=qubits, editable=True)\n",
    "for j, i in enumerate(h.__dict__['_history']):\n",
    "    if 'instruction' in i.keys():\n",
    "        try:\n",
    "            c.append_circuit_inplace(i['instruction'].data['circuit'].circuit)\n",
    "        except:\n",
    "            print(j, i['instruction'].data)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "18ff271d-5d3d-4189-9bf6-583e9b520151",
   "metadata": {},
   "outputs": [],
   "source": [
    "#if Iz: create new qubit, take note of what has been measured, update mapping\n",
    "def expand_circuit(c):\n",
    "    qubit_mapping = {q:[q] for q in c.line_labels}\n",
    "    q_idx = len(qubit_mapping)-1\n",
    "    new_c = []\n",
    "    measurements = []\n",
    "    #serialize\n",
    "    serial_c = c.serialize()\n",
    "    #for each \n",
    "    for gate in serial_c:\n",
    "        #print(gate)\n",
    "        #if not Iz: add it, with proper qubit map\n",
    "        if gate.name=='Iz':\n",
    "            q = gate.qubits[0] #TODO\n",
    "            measurements.append('Q'+str(qubit_mapping[q][-1]) if len(qubit_mapping[q])>1 else qubit_mapping[q][-1])\n",
    "            q_idx +=1\n",
    "            #update qubit mapping\n",
    "            qubit_mapping[q].append(q_idx)\n",
    "        else:\n",
    "            g = gate.name\n",
    "            qs = ['Q'+str(qubit_mapping[q][-1]) if len(qubit_mapping[q])>1 else qubit_mapping[q][-1] for q in gate.qubits]\n",
    "            #print(g, qs)\n",
    "            new_c.append([pygsti.baseobjs.label.Label(g, qs)])\n",
    "            \n",
    "    #TODO at the end of the circuit, need to add a final measurement of the data qubits. \n",
    "    new_c = pygsti.circuits.circuit.Circuit(new_c)\n",
    "    return new_c, measurements, qubit_mapping"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6766e65e-455b-4f6a-bbde-e54eeeeb3587",
   "metadata": {},
   "outputs": [],
   "source": [
    "#detectors are going to be correspoding pairs of syndromes and the data qubit Z parity. Create these detectors"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a304f33a-066a-494b-a486-bb1461e5fb9e",
   "metadata": {},
   "outputs": [],
   "source": [
    "expanded_c, measurements, qubit_mapping = expand_circuit(c)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "89bf93ea-1116-4296-b51b-d455c1898eff",
   "metadata": {},
   "outputs": [],
   "source": [
    "expanded_c"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "db179833-07ea-4c19-9bbc-223c8e33c7e1",
   "metadata": {},
   "outputs": [],
   "source": [
    "#constructing the detectors \n",
    "n_qubits = len(expanded_c.line_labels)\n",
    "meas_as_int = [('Z',[int(m[1:])]) for m in measurements[:-1*n_data]]+[('Z'*n_data, [int(m[1:]) for m in measurements[-1*n_data:]])]\n",
    "detectors = []\n",
    "for k in range(n_syndromes):\n",
    "    detectors.append(dems.get_detector_as_parity([k], meas_as_int, n_qubits))\n",
    "#detectors.append( for measurements[:n_syndromes]) #first round\n",
    "for i in range(1,rounds):\n",
    "    for k in range(n_syndromes):\n",
    "        #2-body Z stimpaulis\n",
    "        detectors.append(dems.get_detector_as_parity([6*(i-1)+k, 6*i+k], meas_as_int, n_qubits)) #for d in detectors\n",
    "detectors.append(dems.get_detector_as_parity( [6*rounds], meas_as_int, n_qubits)) #logical observable"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "febcf7e1-6dfb-4f92-ae67-bd214d90f2e6",
   "metadata": {},
   "source": [
    "# DEM creation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8bef671e-5ee5-426e-854c-51e1413ee313",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pygsti.tools.errgenproptools as eprop\n",
    "from pygsti.errorgenpropagation.errorpropagator import ErrorGeneratorPropagator"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "13bfc30b-8e34-4b04-ab60-daf9db1750ad",
   "metadata": {},
   "outputs": [],
   "source": [
    "exp_qubits = list(range(n_qubits))#[\"A0\", \"A1\"] + [f\"D{i+2}\" for i in range(5)]\n",
    "\n",
    "exp_availability={'Gcphase':[(a,b) for a in exp_qubits for b in exp_qubits if a != b], 'Gcnot':[(a,b) for a in exp_qubits for b in exp_qubits if a != b]}\n",
    "exp_pspec = pygsti.processors.QubitProcessorSpec(len(exp_qubits), ['Gcphase' ,'Gh', 'Gypi','Gypi2', 'Gympi2', 'Gxpi2', 'Gxpi', 'Gxmpi2', 'Gi', 'Gc0', 'Gcnot', 'Gzpi2', 'Gzpi'],\n",
    "                                         availability=exp_availability, qubit_labels=exp_qubits)\n",
    "\n",
    "exp_model = obj.build_model(error_rates_dict, exp_pspec, oneq_gates, twoq_gates)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1b572ec6-2d41-437a-a884-59e2c97536fa",
   "metadata": {},
   "outputs": [],
   "source": [
    "expanded_c = expanded_c.reorder_lines([f'Q{i}' for i in range(n_qubits)])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "26f2a996-20aa-482e-84a4-6beff752fba4",
   "metadata": {},
   "outputs": [],
   "source": [
    "expanded_c_int_labels = expanded_c.map_state_space_labels({f'Q{i}':i for i in range(n_qubits)})\n",
    "expanded_c_int_labels = expanded_c_int_labels.map_state_space_labels({i:i for i in range(n_qubits)})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7d6df615-6e5f-4e49-b8df-ca4dc8daf5d6",
   "metadata": {},
   "outputs": [],
   "source": [
    "stim_c_no_extras = obj.pygsti_c_to_stim(expanded_c_int_labels)\n",
    "tableau = stim.Tableau.from_circuit(stim_c_no_extras, ignore_measurement=True) \n",
    "inverse_tableau = tableau.inverse()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "233cebdf-e999-424e-9e19-61ec1ebd3189",
   "metadata": {},
   "outputs": [],
   "source": [
    "#TODO separate into H and non-H?\n",
    "egp = ErrorGeneratorPropagator(exp_model)\n",
    "\n",
    "eoc_eeg = egp.propagate_errorgens_bch(expanded_c_int_labels, bch_order=1, include_spam=False)\n",
    "\n",
    "sim = stim.TableauSimulator()\n",
    "sim.set_inverse_tableau(inverse_tableau)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a457ba1e-02c0-4450-96df-1f9ca0e6c745",
   "metadata": {},
   "outputs": [],
   "source": [
    "dem = dems.generate_dem(detectors, eoc_eeg, sim)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8006eee3-cc3f-469f-8f14-3c6169cd9a80",
   "metadata": {},
   "outputs": [],
   "source": [
    "#we can now sample from the DEM\n",
    "n_shots = 10000000\n",
    "stim_dem_str = dems.format_dem_stim(dem, n_logical=0)\n",
    "stim_dem = stim.DetectorErrorModel(stim_dem_str)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "48d18818-c2b5-4283-a974-2a17f88c8683",
   "metadata": {},
   "outputs": [],
   "source": [
    "def null_logl(data):\n",
    "    n_counts = sum(data.values())\n",
    "    logl = sum(v*np.log(v/n_counts) for k,v in data.items())\n",
    "    return logl"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "83a8857e-a236-45f0-a9a3-4d4333701e10",
   "metadata": {},
   "outputs": [],
   "source": [
    "#why don't I just estimate successive polarizations from the data and from the DEM\n",
    "#then check how far they are from each other"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "90ab7bbf-f6ec-4ed0-9279-63a54b188431",
   "metadata": {},
   "outputs": [],
   "source": [
    "from itertools import chain, combinations\n",
    "\n",
    "def powerset(iterable):\n",
    "    s = list(iterable)\n",
    "    return chain.from_iterable(combinations(s, r) for r in range(len(s) + 1))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ec6e5dcf-52c3-4c54-ab1b-475a773af5b7",
   "metadata": {},
   "outputs": [],
   "source": [
    "def dot_prod(k,y):\n",
    "    return sum(int(k[i])*int(y[i]) for i in range(len(k)))%2\n",
    "    \n",
    "def compute_polarization_from_data(count_dict, y):\n",
    "    #y should be list of 0s and 1s\n",
    "    total_counts = sum(count_dict.values())\n",
    "    pol = sum(v*(-1)**dot_prod(k,y)/total_counts for k,v in count_dict.items())\n",
    "    return pol"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fa30043b-dc02-473d-a50a-87bf623825d9",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_polarization_from_dem():\n",
    "    #we have the event probs. need to do the inverse of the chain of logs, Walsh-Hadamards, etc. to go back to polarizations\n",
    "    #turn into an appropriate vector\n",
    "    v = []\n",
    "    attens = np.log(v)\n",
    "    k = 0#binary string to int\n",
    "    pol = np.exp(scipy.linalg.hadamard()[k] @ attens) #should be able to just pick out appropriate row of Hadamard\n",
    "\n",
    "    return pol"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c96fcf72-2ee9-4220-b5eb-20eadf3ce5cc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_outcome_distribution_from_dem(dem):\n",
    "    \"\"\"\n",
    "    Compute the outcome distribution from a DEM using log and Hadamard transform.\n",
    "\n",
    "    Parameters:\n",
    "    - dem: a detector error model\n",
    "\n",
    "    Returns: \n",
    "    - prob_estimate: array of 2^n probabilities, in increasing binary order\n",
    "    \"\"\"\n",
    "    # Convert DEM to attenuations\n",
    "    attenuations = np.zeros(2**dem.num_detectors, dtype=float)\n",
    "    all_bitstrings = np.array([[int(bit) for bit in format(n, f'0{dem.num_detectors}b')]for n in range(2**dem.num_detectors)])\n",
    "    for event in dem:\n",
    "        prob = event.args_copy()[0]\n",
    "        targets = [target.val for target in event.targets_copy()]\n",
    "        event = [1 if (dem.num_detectors-idx-1) in targets else 0 for idx in range(dem.num_detectors)]    \n",
    "        attenuation = -np.log(1-2*prob)\n",
    "        attenuations += attenuation * (1-(-1)**np.dot(all_bitstrings, event))/2\n",
    "    \n",
    "    # Compute polarizations from attenuations\n",
    "    polarizations = np.exp(-attenuations)\n",
    "    polarizations[0] = 1\n",
    "\n",
    "    # Compute probabilities from polarizations\n",
    "    probabilities = sp.linalg.hadamard(2**dem.num_detectors) @ polarizations / 2**dem.num_detectors\n",
    "    \n",
    "    return probabilities"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "26789a3d-ccb7-44ae-886a-103cb993ab23",
   "metadata": {},
   "outputs": [],
   "source": [
    "def dem_to_event_probabilities(dem):\n",
    "    \"\"\"\n",
    "    Convert a stim DEM object into a 2^n dimensional list of event probabilities. \n",
    "\n",
    "    Parameters:\n",
    "    - dem: stim DEM object to convert to event probability list\n",
    "\n",
    "    Returns:\n",
    "    - dem_event_probabilities: 2^n dimensional array of dem event probabilities\n",
    "    \"\"\"\n",
    "\n",
    "    n = dem.num_detectors\n",
    "    attenuations = np.zeros(2**n, dtype=float)\n",
    "    for event in dem:\n",
    "        probability = event.args_copy()[0]\n",
    "        targets = [target.val for target in event.targets_copy()]\n",
    "        idxs = [1 << target for target in targets]\n",
    "        idx = sum(idxs)\n",
    "        attenuations[idx] += -np.log(1-2*probability)\n",
    "\n",
    "    probabilities = 1/2 - 1/2*np.exp(-attenuations)\n",
    "    \n",
    "    return probabilities\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "91779e02-d435-4a20-92cd-8b2fb8c00d9b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_logl(stim_dem, data):\n",
    "    outcome_distribution = compute_outcome_distribution_from_dem(stim_dem)\n",
    "    #iterate through the keys \n",
    "    val = 0\n",
    "    for k, c in data.items():\n",
    "        #compute prob of k\n",
    "        binary_k = int(k[::-1], 2)\n",
    "        p = outcome_distribution[binary_k]\n",
    "        val += c*np.log(p)\n",
    "\n",
    "    return val"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "93d44765-17fa-48d0-b92c-b9dc30eb50ba",
