    "from loqs.codepacks import codepack_5_1_3_quantinuum2022 as codepack_5_1_3\n",
    "qubits = [f'Q{i}' for i in range(10)]#[\"A0\", \"A1\", \"A2\"] + [f\"D{i+2}\" for i in range(7)]\n",
    "\n",
    "ideal_model = codepack.create_ideal_model(qubits) # 7 physical qubit model for simulating 1 logical qubit\n",
    "code = codepack.create_qec_code()\n",
    "\n",
    "availability={'Gcnot':[(a,b) for a in qubits for b in qubits if a != b]}\n",
    "pspec = pygsti.processors.QubitProcessorSpec(len(qubits), ['Gh', 'Gcnot','Gi'], qubit_labels=qubits,\n",
    "                                         availability=availability)"
   ]
  },
