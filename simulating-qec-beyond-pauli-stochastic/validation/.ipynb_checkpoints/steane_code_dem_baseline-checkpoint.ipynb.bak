   "source": [
    "def process_se_data_loqs(outcomes_list, n_rounds, n_syndromes):\n",
    "    #xor appropriate bits together\n",
    "    outcomes = [''.join(str(j) for j in bl[:n_syndromes]+[(bl[(r-1)*n_syndromes+k]+bl[r*n_syndromes+k])%2 for k in range(n_syndromes) for r in range(1, n_rounds)]+[bl[-1]]) for bl in outcomes_list]\n",
    "    #create a counter \n",
    "    return Counter(outcomes)"
   ]
  },
